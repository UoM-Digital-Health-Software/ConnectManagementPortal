<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
         http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create table for app configs / feature flags -->
    <changeSet id="20260416150000_add_latest_measurement_dates_tracker" author="Jindrich Gorner">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="latest_measurement_dates_tracker"/>
            </not>
        </preConditions>


        <createTable tableName="latest_measurement_dates_tracker">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="summary_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="request_on"  type="timestamp" defaultValueDate="${now}" >
                <constraints nullable="false"/>
            </column>
            <column name="generated" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="loaded" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>


    </changeSet>


</databaseChangeLog>
