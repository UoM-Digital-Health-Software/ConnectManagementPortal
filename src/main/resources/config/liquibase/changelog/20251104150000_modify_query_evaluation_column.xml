<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
         http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- Create table for app configs / feature flags -->
    <changeSet id="20251104150000_modify_query_evaluation_column" author="Jindrich Gorner">


        <renameColumn
                tableName="query_evaluation"
                oldColumnName="notification_sent"
                newColumnName="notification_scheduled"
                columnDataType="boolean"/>

    </changeSet>

    <changeSet id="20251107150000_update-query_evaluation-aud" author="Jindrich Gorner">
        <addColumn tableName="query_evaluation_aud">
            <column name="notification_scheduled" type="boolean" />
            <column name="notification_scheduled_mod" type="boolean" />

        </addColumn>
    </changeSet>

    <changeSet id="20260128150000_update-add-reference-query" author="Jindrich Gorner">
        <addColumn tableName="query">
            <column name="reference_type" type="varchar(50)" >
                <constraints nullable="true"/>
            </column>

            <column name="rolling_window" type="varchar(32)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
